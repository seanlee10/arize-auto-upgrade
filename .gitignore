# 렌더 결과(비밀 포함)만 무시한다. config/values.yaml 은 체크인 대상이다.
/values.yaml
.env
__pycache__/
*.pyc
.venv/
arize-distribution-*/

# Design docs stay local: they quote vendor-internal detail and are not
# part of what this repo distributes.
docs/
.superpowers/
*.egg-info/

# ~/.gitignore_global excludes CLAUDE.md; this repo tracks it deliberately
!CLAUDE.md
